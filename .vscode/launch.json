{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Terraform Provider",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      // this assumes your workspace is the root of the repo
      "program": "${workspaceFolder}",
      "env": {},
      "args": [
        "-debug",
      ]
    },
    {
      "name": "Launch test function",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "showLog": true,
      "args": [
        "-test.v",
        "-test.run",
        "TestDatasource_RepositoryDockerHosted"
      ]
    }
  ]
}